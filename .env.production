# lab-management-system-nextjs 生产环境变量
# build-time 烘焙的 NEXT_PUBLIC_*(编进 client bundle)
# runtime 的 AUTH_JWT_SECRET / SAAS_BASE_URL 等由 lab.env 在 VPS 注入

# MSW 关闭 → 前端走真后端 (https://lab-nextjs.xiangru.uk/api/v1/*)
# 真 DB 是 SQLite,挂 /data/lab.db 卷,由 runtime DB_PATH 配
NEXT_PUBLIC_ENABLE_MSW=false
NEXT_PUBLIC_API_BASE_URL=

# SSO 走 saas-nextjs
NEXT_PUBLIC_SAAS_BASE_URL=https://saas-nextjs.xiangru.uk
SAAS_BASE_URL=https://saas-nextjs.xiangru.uk