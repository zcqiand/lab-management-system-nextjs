{
  "name": "lab-management-system-nextjs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Full-stack frontend + schema emit + pg runtime lender for the lab-management-system 7-repo family.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gate": "cd ../.. && python scripts/gate.py -p lab-management-system-nextjs",
    "test": "vitest run",
    "trace": "TRACE_MAP=1 vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "gen:shared": "tsx scripts/gen-shared.ts",
    "prebuild": "npm run gen:shared",
    "borrow:pg": "node scripts/borrow-pg.mjs",
    "borrow:pg:sibling": "node scripts/borrow-from-nextjs-pg.mjs",
    "emit:schema": "node scripts/emit-schema.mjs",
    "emit:dbml": "node scripts/v-sql-to-dbml.mjs",
    "drizzle:pull": "drizzle-kit pull --config=drizzle.config.pg.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.7.9",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "orval": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.0"
  }
}
