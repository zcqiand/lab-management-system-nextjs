{
  "name": "lab-management-system-nextjs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Full-stack frontend + schema emit + pg runtime lender for the lab-management-system 7-repo family.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gate": "cd ../.. && python scripts/gate.py -p lab-management-system-nextjs",
    "test": "vitest run",
    "trace": "TRACE_MAP=1 vitest run",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "gen:shared": "tsx scripts/gen-shared.ts",
    "prebuild": "npm run gen:shared",
    "borrow:pg": "node scripts/borrow-pg.mjs",
    "borrow:pg:sibling": "node scripts/borrow-from-nextjs-pg.mjs",
    "emit:schema": "node scripts/emit-schema.mjs",
    "emit:dbml": "node scripts/v-sql-to-dbml.mjs",
    "drizzle:pull": "drizzle-kit pull --config=drizzle.config.pg.ts",
    "fix:schema": "node scripts/fix-pulled-schema.mjs",
    "seed:db": "tsx --env-file-if-exists=.env scripts/seed-db.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lab/management-system-msw": "file:../lab-management-system-msw",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.7.9",
    "docx-preview": "^0.4.0",
    "docxtemplater": "^3.69.3",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "pizzip": "^3.2.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^6.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.31.0",
    "msw": "^2.15.0",
    "openapi-types": "^12.1.3",
    "orval": "^7.21.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.0"
  }
}
