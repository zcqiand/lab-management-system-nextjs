# Lab-Management-System-Next.js env（demo 用）
#
# ADR-0014：后端模式改用 env 单 URL 配置。运行时切换（BackendSwitcher + localStorage）
# 已废弃。后端 URL / MSW 启动 / mode 标签全部走 .env。

# ===== 后端 URL（ADR-0014：单一 URL）=====
# 默认 "" 同源，命中本仓 Next.js API routes
# 改成具体 URL（如 http://localhost:5000）即切到外部后端
NEXT_PUBLIC_API_BASE_URL=

# ===== MSW Service Worker 启动开关（ADR-0014）=====
# dev 默认 true（同源时被 SW 拦截），prod 默认 false
NEXT_PUBLIC_ENABLE_MSW=true

# ===== mode 显示标签（ADR-0014：仅 UI 显示，不参与路由）=====
NEXT_PUBLIC_API_MODE=msw

# ===== SaaS 身份平台（SSO + 菜单来源）=====
# 浏览器请求 saas 跨域 → 走本仓 /api/saas/* 反代；服务端 fetch 用这个 env。
NEXT_PUBLIC_SAAS_BASE_URL=http://localhost:3000

# 本应用在 saas 注册的 appCode（apps.json 里的 code）
# 用来从 /api/v1/me/menus 返回的 { [appCode]: EffectiveMenuNode[] } 里挑本仓菜单
NEXT_PUBLIC_LAB_APP_CODE=lab-management

# ===== 数据库 =====
# pg 借链（db.smoke.test.ts / sync-db.mjs / emit-schema.mjs 共用）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lab_dev