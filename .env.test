# .env.test — lab-management-system-nextjs vitest 测试期覆盖
#
# 镜像 lab-management-system-{msw,springboot,aspnetcore} 三仓：四仓共享 LAB_JWT_SECRET，
# 让 MSW 签出来的 access token 在本仓 vitest 测试期间能被 jose jwtVerify 验签通过。
# ADR-0008 后统一 HS256 真签, 不再走 alg=none 兜底。

# === JWT signing (HS256, RFC 7519) ===
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600

# === API mode (vitest 走同源 relative URL, 触发 setupServer) ===
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_MODE=msw-http
NEXT_PUBLIC_ENABLE_MSW=true