# Lab-Management-System-Next.js env（demo 用）
#
# ADR-0014：后端模式改用 env 单 URL 配置。运行时切换（BackendSwitcher + localStorage）
# 已废弃。后端 URL / MSW 启动 / mode 标签全部走 .env。

# ===== 后端 URL（ADR-0014：单一 URL + ADR-0012 B 强度）=====
# dev 默认走独立 lab-msw HTTP server :5200（ADR-0012 B 强度）
# 改成 "" 同源切回本仓 Next.js API routes（nextjs-self 模式，旧 v0.4 行为）
# 改成 http://localhost:5204 / http://localhost:5205 切到 aspnetcore / springboot 真后端（conventions §6 端口分段）
NEXT_PUBLIC_API_BASE_URL=http://localhost:5200

# ===== mode 显示标签（ADR-0014：仅 UI 显示，不参与路由）=====
# msw-http = 独立 HTTP mock 后端；aspnetcore / springboot = 真后端
# ADR-0012 v0.3.0：删除 NEXT_PUBLIC_ENABLE_MSW（Service Worker 模式已删除）
NEXT_PUBLIC_API_MODE=msw-http

# ===== SaaS 身份平台（SSO + 菜单来源）=====
# 浏览器请求 saas 跨域 → 走本仓 /api/saas/* 反代；服务端 fetch 用这个 env。
NEXT_PUBLIC_SAAS_BASE_URL=http://localhost:5101

# Phase 4: 拆分 SAAS_BASE_URL → SAAS_IDP_URL (server, IdP 端点) + SAAS_UI_BASE_URL (server, UI 页)
# saas-identity-platform-nextjs 既作 IdP (POST /api/v1/oauth/authorize + /token) 又作 UI (/login),
# dev 两个 env 都 = http://localhost:5101; prod 都 = https://saas-nextjs.xiangru.uk。
SAAS_IDP_URL=http://localhost:5101
SAAS_UI_BASE_URL=http://localhost:5101

# 本应用在 saas 注册的 appCode（apps.json 里的 code）
# 用来从 /api/v1/me/menus 返回的 { [appCode]: EffectiveMenuNode[] } 里挑本仓菜单
NEXT_PUBLIC_LAB_APP_CODE=lab-management

# OAuth client_id（apps.client_id 收敛后的 UUID,V014/V015 同步）。
# 浏览器侧走 NEXT_PUBLIC_* env 覆盖；ADR-0019 禁字面 fallback。
# dev 用 dev seed UUID;prod 改 saas 真实 client_id。
NEXT_PUBLIC_SAAS_OAUTH_CLIENT_ID=11111111-1111-1111-1111-111111111111

# 菜单快照服务账号（2026-08-27 demo 兜底删除配套）：密码登录用户无 saas 身份，
# login 后用它登 saas /api/v1/auth/login 换 token 拉 /me/menus 快照。
# dev 默认 alice（saas seeds，role-admin 全量菜单授权）。prod 走 env 不得带出本机。
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456

# ===== 本仓 auth（读法见 src/lib/auth/factory.ts readLabConfig）=====
# 注意：本仓 JWT 键名是 LAB_JWT_*（不是 msw/springboot 仓的 JWT_SIGNING_KEY）。
# prod 密钥由 deploy 脚本写入 VPS lab.env（LAB_JWT_SECRET）。
LAB_JWT_SECRET=dev-key-32-bytes-minimum-length!
LAB_JWT_ISSUER=lab-management-system
LAB_JWT_TTL_SECONDS=3600
LAB_JWT_REFRESH_TTL_SECONDS=604800
LAB_SSO_PROFILE=no-sso
# LAB_SAAS_BASE / LAB_SAAS_CLIENT_ID / LAB_SAAS_CLIENT_SECRET / LAB_SAAS_DEFAULT_TENANT_ID /
# LAB_SSO_CALLBACK_REDIRECT / LAB_AUTH_DEV_PASSWORD 见 factory.ts；dev 有 fallback，按需覆盖。

# ===== SaaS OAuth（src/app/api/auth/sso/{authorize,callback}）=====
# 2026-08-28 V014/V015 收敛 apps.client_id 为固定 UUID，3 个 saas 后端共用
SAAS_OAUTH_CLIENT_ID=11111111-1111-1111-1111-111111111111
# SAAS_OAUTH_CLIENT_SECRET / SAAS_TENANT_ID / SAAS_OAUTH_SCOPE dev 有 fallback，按需覆盖。

# ===== 数据库 =====
# pg 借链（db.smoke.test.ts / sync-db.mjs / emit-schema.mjs 共用）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lab_dev
