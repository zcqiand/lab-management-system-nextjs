# lab-management-system-nextjs 生产环境变量
# build-time 烘焙的 NEXT_PUBLIC_*(编进 client bundle)
# runtime 的 AUTH_JWT_SECRET / SAAS_BASE_URL 等由 lab.env 在 VPS 注入

# 空串 = 同源相对 URL（lab 自家 Next.js API routes 接 PG，ADR-0014）
# 真 DB 是 SQLite,挂 /data/lab.db 卷,由 runtime DB_PATH 配
NEXT_PUBLIC_API_BASE_URL=
# 显示标签（env.ts 默认 "msw-http"，生产要显示真实后端）
NEXT_PUBLIC_API_MODE=nextjs

# SSO 走 saas-nextjs (OAuth IdP + UI 同域)
# Phase 4 env 对称化: SAAS_BASE_URL → SAAS_IDP_URL (server) + SAAS_UI_BASE_URL (server)
NEXT_PUBLIC_SAAS_BASE_URL=https://saas-nextjs.xiangru.uk
SAAS_IDP_URL=https://saas-nextjs.xiangru.uk
SAAS_UI_BASE_URL=https://saas-nextjs.xiangru.uk

# ===== 以下 key 与 .env.example 全集对齐（T10: key 集合拉齐）=====
# prod 值由 deploy 脚本写入 VPS lab.env 覆盖;placeholder-vps = 不得带出本机真实值
NEXT_PUBLIC_LAB_APP_CODE=lab-management
LAB_SAAS_SERVICE_USER=placeholder-vps
LAB_SAAS_SERVICE_PASSWORD=placeholder-vps
LAB_JWT_SECRET=placeholder-vps
LAB_JWT_ISSUER=lab-management-system
LAB_JWT_TTL_SECONDS=3600
LAB_JWT_REFRESH_TTL_SECONDS=604800
LAB_SSO_PROFILE=sso
SAAS_OAUTH_CLIENT_ID=lab-mgmt
DATABASE_URL=postgresql://postgres:placeholder-vps@PROD-HOST:5432/lab_prod